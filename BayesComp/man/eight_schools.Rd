\name{eight_schools}
\alias{eight_schools}
\title{Rubin's Eight Schools Coaching Estimates}
\description{
Reported estimates of coaching effects and their standard errors in eight
experiments. The Section 6 companion uses these summaries for numerical
inversion and importance sampling.
}
\usage{data(eight_schools)}
\format{
A data frame with eight rows and three columns.
\describe{
  \item{\code{school}}{School identifier, A through H.}
  \item{\code{effect}}{Estimated coaching effect in SAT-Verbal points.}
  \item{\code{se}}{Reported standard error in SAT-Verbal points.}
}
}
\source{Rounded estimates from Rubin (1984), Table 3, as transcribed in
the STA5001 lecture notes.}
\keyword{datasets}
